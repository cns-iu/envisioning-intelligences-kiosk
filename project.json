{
  "name": "envisioning-intelligences-kiosk",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "includedScripts": [],
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "./src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/envisioning-intelligences-kiosk",
        "browser": "./src/main.ts",
        "tsConfig": "tsconfig.app.json",
        "loader": {
          ".css": "text"
        },
        "inlineStyleLanguage": "scss",
        "styles": ["./src/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["./src/styles/utils"]
        },
        "assets": [
          {
            "glob": "**/*",
            "input": "public"
          }
        ]
      },
      "configurations": {
        "production": {
          "baseHref": "/envisioning-intelligences-kiosk/",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "baseHref": "/",
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true
        },
        "preview": {
          "baseHref": "/apps/envisioning-intelligences-kiosk/",
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "envisioning-intelligences-kiosk:build:production"
        },
        "development": {
          "buildTarget": "envisioning-intelligences-kiosk:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "include": ["src/**/*.spec.ts"],
        "setupFiles": ["src/test-setup.ts"],
        "coverage": true,
        "coverageInclude": ["src/**/*.ts"],
        "coverageExclude": ["src/**/index.ts", "src/**/main.ts", "src/**/test-setup.ts"],
        "coverageReporters": ["html", "lcovonly", "json-summary", "text-summary"],
        "coverageThresholds": {
          "branches": 85,
          "functions": 85,
          "lines": 85,
          "statements": 85
        },
        "watch": false
      },
      "configurations": {
        "watch": {
          "watch": true
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "envisioning-intelligences-kiosk:build",
        "staticFilePath": "dist/envisioning-intelligences-kiosk/browser",
        "spa": true
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nx format:write"
      }
    }
  }
}
